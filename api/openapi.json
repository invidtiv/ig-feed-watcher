{
  "openapi": "3.0.3",
  "info": {
    "title": "IG Feed Watcher — Feed Data API",
    "version": "1.2.0",
    "description": "Data contract for the IG Feed Watcher feed database. GET requests are always available; mutation methods require FULL_AGENT=1. Provides all feeds, per-group feeds, individual posts with their image, sources/cookies management, full interest-group management (including per-group image retention), JSON metadata export, and the self-installable agent skill for this API."
  },
  "servers": [
    {
      "url": "http://localhost:4180",
      "description": "Web Explorer server (PORT env overrides the port)"
    }
  ],
  "tags": [
    { "name": "feeds", "description": "Feed posts stored in the database" },
    { "name": "groups", "description": "Interest groups and their feeds; full group management (accounts, keywords, hashtags, image retention)" },
    { "name": "sources", "description": "Ingestion sources (accounts) and their cookies" },
    { "name": "export", "description": "Bulk JSON export of post metadata" },
    { "name": "skill", "description": "The self-installable agent skill for this API" }
  ],
  "paths": {
    "/api/feeds": {
      "get": {
        "tags": ["feeds"],
        "summary": "List all feeds (posts)",
        "description": "Returns all posts across every source, with optional filters. This is the canonical feed listing endpoint; /api/posts is a backward-compatible alias.",
        "parameters": [
          { "$ref": "#/components/parameters/limit" },
          { "$ref": "#/components/parameters/offset" },
          { "$ref": "#/components/parameters/source" },
          { "$ref": "#/components/parameters/group" },
          { "$ref": "#/components/parameters/author" },
          { "$ref": "#/components/parameters/search" },
          { "$ref": "#/components/parameters/reel" },
          { "$ref": "#/components/parameters/date_from" },
          { "$ref": "#/components/parameters/date_to" },
          { "$ref": "#/components/parameters/sort" },
          { "$ref": "#/components/parameters/order" }
        ],
        "responses": {
          "200": {
            "description": "A page of posts.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PostList" } } }
          }
        }
      }
    },
    "/api/groups/{id}/feeds": {
      "get": {
        "tags": ["groups", "feeds"],
        "summary": "List feeds for a single group",
        "parameters": [
          { "$ref": "#/components/parameters/groupId" },
          { "$ref": "#/components/parameters/limit" },
          { "$ref": "#/components/parameters/offset" },
          { "$ref": "#/components/parameters/source" },
          { "$ref": "#/components/parameters/author" },
          { "$ref": "#/components/parameters/search" }
        ],
        "responses": {
          "200": {
            "description": "Posts matched to the group.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PostList" } } }
          },
          "404": { "description": "Group not found.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/api/feeds/{shortcode}": {
      "get": {
        "tags": ["feeds"],
        "summary": "Get an individual post with its image reference",
        "parameters": [
          { "$ref": "#/components/parameters/shortcode" }
        ],
        "responses": {
          "200": {
            "description": "A single post including an `image` object pointing at the raw image endpoint.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PostDetail" } } }
          },
          "404": { "description": "Post not found." }
        }
      }
    },
    "/api/feeds/{shortcode}/image": {
      "get": {
        "tags": ["feeds"],
        "summary": "Serve the raw image for a post",
        "parameters": [
          { "$ref": "#/components/parameters/shortcode" }
        ],
        "responses": {
          "200": {
            "description": "The image bytes.",
            "content": {
              "image/jpeg": { "schema": { "type": "string", "format": "binary" } },
              "image/png": { "schema": { "type": "string", "format": "binary" } },
              "image/webp": { "schema": { "type": "string", "format": "binary" } }
            }
          },
          "404": { "description": "Post not found, or no image available." }
        }
      }
    },
    "/api/export": {
      "get": {
        "tags": ["export"],
        "summary": "Export post metadata as JSON",
        "description": "Returns all (or filtered) posts as a JSON array under `posts`. Add `?download=1` to force a file download.",
        "parameters": [
          { "$ref": "#/components/parameters/source" },
          { "$ref": "#/components/parameters/group" },
          { "$ref": "#/components/parameters/author" },
          { "$ref": "#/components/parameters/search" },
          { "$ref": "#/components/parameters/date_from" },
          { "$ref": "#/components/parameters/date_to" },
          { "name": "download", "in": "query", "schema": { "type": "string", "enum": ["1"] }, "description": "Set to 1 to return a Content-Disposition attachment." }
        ],
        "responses": {
          "200": {
            "description": "Export payload.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Export" } } }
          }
        }
      }
    },
    "/api/sources": {
      "get": {
        "tags": ["sources"],
        "summary": "List ingestion sources (cookie values masked)",
        "responses": {
          "200": {
            "description": "Sources plus registered ingester types.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SourceList" } } }
          }
        }
      },
      "post": {
        "tags": ["sources"],
        "summary": "Create a source",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SourceInput" } } }
        },
        "responses": {
          "200": { "description": "The created source (masked)." },
          "400": { "description": "Source name is required." },
          "403": { "description": "Only one account can be connected in this version." }
        }
      }
    },
    "/api/sources/{id}": {
      "put": {
        "tags": ["sources"],
        "summary": "Update a source (name, enabled, type, or cookies)",
        "parameters": [ { "$ref": "#/components/parameters/sourceId" } ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SourceInput" } } }
        },
        "responses": {
          "200": { "description": "The updated source (masked)." },
          "404": { "description": "Source not found." }
        }
      },
      "delete": {
        "tags": ["sources"],
        "summary": "Delete a source",
        "parameters": [ { "$ref": "#/components/parameters/sourceId" } ],
        "responses": {
          "200": { "description": "Deleted." },
          "404": { "description": "Source not found." }
        }
      }
    },
    "/api/sources/{id}/cookies": {
      "put": {
        "tags": ["sources"],
        "summary": "Insert/replace cookie values for a source",
        "parameters": [ { "$ref": "#/components/parameters/sourceId" } ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["cookies"],
                "properties": {
                  "cookies": { "type": "array", "items": { "$ref": "#/components/schemas/Cookie" } }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Cookies saved (values masked in response)." },
          "404": { "description": "Source not found." }
        }
      }
    },
    "/api/groups": {
      "get": {
        "tags": ["groups"],
        "summary": "List interest groups with full details",
        "description": "Returns every group with its id, name, color, 👤 accounts, 🔑 keywords, # hashtags, optional retention_days, Telegram thread id, and live post_count.",
        "responses": {
          "200": {
            "description": "All groups.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GroupList" } } }
          }
        }
      },
      "post": {
        "tags": ["groups"],
        "summary": "Create a group",
        "description": "Creates a group. `name` is required; `color` defaults to #6366f1; accounts, keywords, and hashtags are optional initial lists. A Telegram forum topic is created for the group when Telegram is configured.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GroupCreateInput" } } }
        },
        "responses": {
          "200": {
            "description": "The created group.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GroupResult" } } }
          },
          "400": {
            "description": "Group name is required, or a group with this name already exists.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/api/groups/{id}": {
      "get": {
        "tags": ["groups"],
        "summary": "Get one group with full details",
        "description": "Returns a single group including its 👤 accounts, 🔑 keywords, # hashtags, optional retention_days, and live post_count.",
        "parameters": [ { "$ref": "#/components/parameters/groupId" } ],
        "responses": {
          "200": {
            "description": "The group.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GroupDetail" } } }
          },
          "404": {
            "description": "Group not found.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      },
      "put": {
        "tags": ["groups"],
        "summary": "Update a group (rename, recolor, replace lists)",
        "description": "Updates the group. All fields are optional. Providing `accounts`, `keywords`, or `hashtags` REPLACES the full list; omit a list to leave it unchanged. To add or remove a single item, use POST /api/groups/{id}/add and POST /api/groups/{id}/remove instead.",
        "parameters": [ { "$ref": "#/components/parameters/groupId" } ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GroupUpdateInput" } } }
        },
        "responses": {
          "200": {
            "description": "The updated group.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GroupResult" } } }
          },
          "404": {
            "description": "Group not found.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      },
      "delete": {
        "tags": ["groups"],
        "summary": "Delete a group",
        "description": "Deletes the group. Existing posts are kept but lose their group association.",
        "parameters": [ { "$ref": "#/components/parameters/groupId" } ],
        "responses": {
          "200": {
            "description": "Deleted.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OkResult" } } }
          },
          "404": {
            "description": "Group not found.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/api/groups/{id}/add": {
      "post": {
        "tags": ["groups"],
        "summary": "Add one account, keyword, or hashtag to a group",
        "description": "Adds a single item to the group's 👤 accounts, 🔑 keywords, or # hashtags list. Duplicates are ignored (the item is added only if not already present).",
        "parameters": [ { "$ref": "#/components/parameters/groupId" } ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GroupItemInput" } } }
        },
        "responses": {
          "200": {
            "description": "The updated group.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GroupResult" } } }
          },
          "400": {
            "description": "Value is required.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "404": {
            "description": "Group not found.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/api/groups/{id}/remove": {
      "post": {
        "tags": ["groups"],
        "summary": "Remove one account, keyword, or hashtag from a group",
        "description": "Removes a single item from the group's 👤 accounts, 🔑 keywords, or # hashtags list. Removing an item that is not present is a no-op.",
        "parameters": [ { "$ref": "#/components/parameters/groupId" } ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GroupItemInput" } } }
        },
        "responses": {
          "200": {
            "description": "The updated group.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GroupResult" } } }
          },
          "400": {
            "description": "Value is required.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "404": {
            "description": "Group not found.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/api/contract": {
      "get": {
        "tags": ["feeds"],
        "summary": "This OpenAPI contract (alias of /api/openapi.json)",
        "responses": {
          "200": { "description": "The OpenAPI 3.0 document." }
        }
      }
    },
    "/api/skill": {
      "get": {
        "tags": ["skill"],
        "summary": "Get the self-installable agent skill for this API",
        "description": "Returns the full feed-api agent skill so an agent can install or update it in its own skill library. The default response is a JSON envelope with `name`, `description`, `path`, and the complete `content` (the raw SKILL.md, frontmatter included). Request the raw Markdown with `?format=md`, `?format=markdown`, an `Accept: text/markdown` header, or the `/api/skill.md` alias.",
        "parameters": [
          {
            "name": "format",
            "in": "query",
            "schema": { "type": "string", "enum": ["md", "markdown"] },
            "description": "Return the raw SKILL.md instead of the JSON envelope."
          }
        ],
        "responses": {
          "200": {
            "description": "The agent skill (JSON envelope, or raw Markdown when requested).",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Skill" } },
              "text/markdown": { "schema": { "type": "string" } }
            }
          },
          "404": {
            "description": "Skill file not found.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "shortcode": { "name": "shortcode", "in": "path", "required": true, "schema": { "type": "string" } },
      "groupId": { "name": "id", "in": "path", "required": true, "schema": { "type": "string" }, "description": "Group id (e.g. g_mr7u3k93)." },
      "sourceId": { "name": "id", "in": "path", "required": true, "schema": { "type": "string" }, "description": "Source id." },
      "limit": { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 50, "maximum": 500 }, "description": "Page size." },
      "offset": { "name": "offset", "in": "query", "schema": { "type": "integer", "default": 0 }, "description": "Page offset." },
      "source": { "name": "source", "in": "query", "schema": { "type": "string" }, "description": "Filter by source_id." },
      "group": { "name": "group", "in": "query", "schema": { "type": "string" }, "description": "Filter by group id." },
      "author": { "name": "author", "in": "query", "schema": { "type": "string" }, "description": "Fuzzy-match author username." },
      "search": { "name": "search", "in": "query", "schema": { "type": "string" }, "description": "Fuzzy-match caption text." },
      "reel": { "name": "reel", "in": "query", "schema": { "type": "string", "enum": ["0", "1"] }, "description": "Filter photos (0) or reels (1)." },
      "date_from": { "name": "date_from", "in": "query", "schema": { "type": "string" }, "description": "Posts with timestamp >= this value." },
      "date_to": { "name": "date_to", "in": "query", "schema": { "type": "string" }, "description": "Posts with timestamp <= this value." },
      "sort": { "name": "sort", "in": "query", "schema": { "type": "string", "enum": ["seen_at", "timestamp", "author", "shortcode", "is_priority"], "default": "seen_at" } },
      "order": { "name": "order", "in": "query", "schema": { "type": "string", "enum": ["ASC", "DESC"], "default": "DESC" } }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": { "type": "string", "description": "Human-readable error message." }
        }
      },
      "OkResult": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean" }
        }
      },
      "Skill": {
        "type": "object",
        "required": ["name", "description", "path", "content"],
        "properties": {
          "name": { "type": "string", "description": "Skill name (kebab-case, matches the skill's frontmatter)." },
          "description": { "type": "string", "description": "Skill description from the frontmatter." },
          "path": { "type": "string", "description": "Relative path of the SKILL.md within the app." },
          "content": { "type": "string", "description": "The full SKILL.md content (frontmatter included) — install by writing it to skills/<name>/SKILL.md." }
        }
      },
      "Group": {
        "type": "object",
        "required": ["id", "name", "accounts", "keywords", "hashtags"],
        "properties": {
          "id": { "type": "string", "description": "Stable group id (e.g. g_mr7u3k93)." },
          "name": { "type": "string", "description": "Group name." },
          "color": { "type": ["string", "null"], "description": "Hex color, e.g. #26f50a." },
          "accounts": { "type": "array", "items": { "type": "string" }, "description": "👤 Instagram account usernames this group watches." },
          "keywords": { "type": "array", "items": { "type": "string" }, "description": "🔑 Caption keywords this group matches." },
          "hashtags": { "type": "array", "items": { "type": "string" }, "description": "# Hashtags this group matches (kept with or without the leading #)." },
          "retention_days": { "type": ["integer", "null"], "minimum": 1, "description": "Image retention override used when AUTO_RETENTION=2. Null or absent uses IMAGE_RETENTION_DAYS." },
          "telegramThreadId": { "type": ["integer", "null"], "description": "Telegram forum topic thread id for this group, when Telegram is configured." }
        }
      },
      "GroupDetail": {
        "allOf": [
          { "$ref": "#/components/schemas/Group" },
          {
            "type": "object",
            "properties": {
              "post_count": { "type": "integer", "description": "Number of posts currently matched to this group." }
            }
          }
        ]
      },
      "GroupList": {
        "type": "object",
        "properties": {
          "groups": { "type": "array", "items": { "$ref": "#/components/schemas/GroupDetail" } }
        }
      },
      "GroupCreateInput": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "description": "Group name (required, must be unique)." },
          "color": { "type": "string", "description": "Hex color, e.g. #6366f1. Defaults to #6366f1." },
          "accounts": { "type": "array", "items": { "type": "string" }, "description": "👤 Initial account usernames." },
          "keywords": { "type": "array", "items": { "type": "string" }, "description": "🔑 Initial keywords." },
          "hashtags": { "type": "array", "items": { "type": "string" }, "description": "# Initial hashtags." },
          "retention_days": { "type": ["integer", "null"], "minimum": 1, "description": "Per-group image retention override for AUTO_RETENTION=2." }
        }
      },
      "GroupUpdateInput": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "description": "New group name (rename)." },
          "color": { "type": "string", "description": "New hex color." },
          "accounts": { "type": "array", "items": { "type": "string" }, "description": "Replaces the whole 👤 accounts list." },
          "keywords": { "type": "array", "items": { "type": "string" }, "description": "Replaces the whole 🔑 keywords list." },
          "hashtags": { "type": "array", "items": { "type": "string" }, "description": "Replaces the whole # hashtags list." },
          "retention_days": { "type": ["integer", "null"], "minimum": 1, "description": "Sets the per-group image retention override; null removes it and uses the global value." }
        }
      },
      "GroupItemInput": {
        "type": "object",
        "required": ["type", "value"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["account", "keyword", "hashtag"],
            "description": "Which list to modify: 👤 account, 🔑 keyword, or # hashtag."
          },
          "value": { "type": "string", "description": "The item to add or remove (exact match for remove)." }
        }
      },
      "GroupResult": {
        "type": "object",
        "required": ["ok", "group"],
        "properties": {
          "ok": { "type": "boolean" },
          "group": { "$ref": "#/components/schemas/Group" }
        }
      },
      "MatchedGroup": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "color": { "type": ["string", "null"] },
          "telegramThreadId": { "type": ["integer", "null"] },
          "reasons": { "type": "array", "items": { "type": "string" } }
        }
      },
      "Post": {
        "type": "object",
        "properties": {
          "shortcode": { "type": "string", "description": "Instagram shortcode (primary key)." },
          "permalink": { "type": ["string", "null"] },
          "author": { "type": "string" },
          "caption": { "type": "string" },
          "timestamp": { "type": ["string", "null"] },
          "is_reel": { "type": "integer", "enum": [0, 1] },
          "is_priority": { "type": "integer", "enum": [0, 1] },
          "priority_reasons": { "type": "array", "items": { "type": "string" } },
          "image_urls": { "type": "array", "items": { "type": "string" } },
          "screenshot_path": { "type": ["string", "null"] },
          "screenshot_url": { "type": ["string", "null"], "description": "Relative URL of the screenshot." },
          "scraped_at": { "type": ["string", "null"] },
          "seen_at": { "type": ["string", "null"] },
          "matched_groups": { "type": "array", "items": { "$ref": "#/components/schemas/MatchedGroup" } },
          "source_id": { "type": "string", "description": "Which source ingested this post." },
          "source_name": { "type": "string" },
          "comment_count": { "type": "integer" }
        }
      },
      "Comment": {
        "type": "object",
        "properties": {
          "author": { "type": ["string", "null"] },
          "text": { "type": "string" },
          "timestamp": { "type": ["string", "null"] },
          "like_count": { "type": "integer" },
          "scraped_at": { "type": ["string", "null"] }
        }
      },
      "ImageRef": {
        "type": "object",
        "properties": {
          "url": { "type": "string", "description": "Relative URL of the raw image." },
          "filename": { "type": "string" },
          "contentType": { "type": "string" }
        }
      },
      "PostDetail": {
        "allOf": [
          { "$ref": "#/components/schemas/Post" },
          {
            "type": "object",
            "properties": {
              "image": { "oneOf": [ { "$ref": "#/components/schemas/ImageRef" }, { "type": "null" } ] },
              "comments": { "type": "array", "items": { "$ref": "#/components/schemas/Comment" } }
            }
          }
        ]
      },
      "PostList": {
        "type": "object",
        "properties": {
          "posts": { "type": "array", "items": { "$ref": "#/components/schemas/Post" } },
          "total": { "type": "integer" },
          "limit": { "type": "integer" },
          "offset": { "type": "integer" }
        }
      },
      "Export": {
        "type": "object",
        "properties": {
          "exportedAt": { "type": "string" },
          "total": { "type": "integer" },
          "count": { "type": "integer" },
          "posts": { "type": "array", "items": { "$ref": "#/components/schemas/Post" } }
        }
      },
      "Cookie": {
        "type": "object",
        "required": ["name", "value"],
        "properties": {
          "name": { "type": "string" },
          "value": { "type": "string" },
