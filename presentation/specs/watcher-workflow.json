    { "from": "scrape", "to": "filter", "label": "articles", "variant": "emphasis", "route": "drop", "fromSide": "bottom", "toSide": "top" },
    { "from": "filter", "to": "match", "route": "bottom-channel", "fromSide": "bottom", "toSide": "bottom" },
    { "from": "match", "to": "detail", "label": "new posts", "variant": "emphasis", "fromSide": "top", "toSide": "left", "via": [[430, 417], [430, 243]], "labelAt": [360, 300] },
    { "from": "detail", "to": "save", "label": "INSERT", "route": "drop", "fromSide": "bottom", "toSide": "top", "labelAt": [515, 320] },
    { "from": "save", "to": "hook", "label": "post JSON", "variant": "emphasis", "route": "drop", "fromSide": "bottom", "toSide": "top", "labelAt": [500, 528] },
