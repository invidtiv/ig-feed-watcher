      { "id": "detection", "label": "Detection + group routing", "focus": ["scrape", "filter", "match", "detail", "ratelimit"], "note": "New posts are filtered, matched to groups, and enriched when safe." },
      { "id": "fanout", "label": "Notification fan-out", "focus": ["match", "save", "hook", "tg", "state"], "note": "Every new post is stored, hooked, and announced." }
    ]
  },
  "lanes": [
    { "id": "scheduler", "label": "Scheduler" },
    { "id": "browser", "label": "Headless Chromium" },
    { "id": "storage", "label": "Storage" },
    { "id": "watcher", "label": "watcher.js" },
    { "id": "alerting", "label": "Alerting" }
  ],
  "phases": [
    { "id": "connect", "label": "Trigger + connect", "fromCol": 0, "toCol": 1 },
    { "id": "detect", "label": "Scrape + detect", "fromCol": 2, "toCol": 3, "variant": "emphasis" },
    { "id": "enrich", "label": "Enrich + alert", "fromCol": 4, "toCol": 5, "variant": "dashed" }
  ],
  "groups": [
    { "id": "fanout_group", "label": "Per new post", "lane": "alerting", "fromCol": 4, "toCol": 5, "variant": "emphasis" },
    { "id": "rl_guard", "label": "Rate-limit guard", "lane": "browser", "fromCol": 4, "toCol": 5, "variant": "security" }
  ],
  "mainPath": ["cron", "launch", "loadig", "scrape", "filter", "match", "detail", "save", "hook", "tg", "state"],
  "nodes": [
    { "id": "cron", "lane": "scheduler", "col": 0, "type": "external", "label": "Cron fires", "sublabel": "*/5 * * * *" },
    { "id": "launch", "lane": "browser", "col": 0, "type": "backend", "label": "Open browser", "sublabel": "stealth flags" },
    { "id": "loadig", "lane": "browser", "col": 1, "width": 72, "type": "backend", "label": "Load IG", "sublabel": "cookies · retry" },
    { "id": "scrape", "lane": "browser", "col": 2, "width": 72, "type": "backend", "label": "Scrape", "sublabel": "scroll ×3" },
    { "id": "detail", "lane": "browser", "col": 4, "type": "backend", "label": "Detail page", "sublabel": "caption · comments" },
