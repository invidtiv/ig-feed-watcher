    { "from": "detail", "to": "ratelimit", "label": "429 / error page", "variant": "security", "role": "error", "route": "bottom-channel", "fromSide": "bottom", "toSide": "bottom", "labelAt": [550, 285] },
    { "from": "ratelimit", "to": "state", "label": "pause detail scraping", "variant": "dashed", "route": "drop", "fromSide": "bottom", "toSide": "top", "labelAt": [660, 320] }
  ],
  "cards": [
    { "dot": "cyan", "title": "Bounded runs", "items": ["One run processes at most 10 new posts", "The seen set merges state.json with posts.db", "Every feed post is marked seen to prevent backlog"] },
    { "dot": "violet", "title": "Group routing", "items": ["Groups match by account, keyword, and hashtag", "Matched posts are sent to their own Telegram topic", "The full caption is re-matched after detail scraping"] },
    { "dot": "rose", "title": "Rate-limit guard", "items": ["Detail pages open only for matched or truncated posts", "A 3 s minimum delay sits between detail requests", "A 429 pauses detail scraping for 30 minutes"] }
  ]
}
