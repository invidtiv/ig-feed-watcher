# IG Feed Watcher — Configuration
# Edit these values to customize behavior

# Telegram alert settings (loaded from env if not set here)
# TG_BOT_TOKEN and TELEGRAM_HOME_CHANNEL are read from ~/.hermes/.env

TG_BOT_TOKEN=YOUR_BOT_TOKEN_HERE
TELEGRAM_HOME_CHANNEL=YOUR_CHANNEL_ID_HERE

# Polling interval (minutes) — used by cron, but also as a safety reference
POLL_INTERVAL=5

# Maximum number of new posts to process per run (prevents flood)
MAX_NEW_POSTS_PER_RUN=10

# Instagram cookies file (export from browser DevTools → Application → Cookies)
COOKIES_FILE=./cookies.json

# Multi-account mode. When absent or 0, both the API and watcher enforce one
# Instagram account. Set to 1 to allow multiple accounts. MULTI_ACCOUNTS is
# still accepted as a legacy alias when MULTI_ACCOUNT is absent.
MULTI_ACCOUNT=0

# API capability. When absent or 0, APIs are read-only and allow GET requests
# only. Set to 1 to enable POST, PUT, PATCH, DELETE, and other mutation methods.
FULL_AGENT=0

# Automatic image retention:
#   0 / absent — keep images indefinitely
#   1          — apply IMAGE_RETENTION_DAYS to every image
#   2          — per-group retention_days, with IMAGE_RETENTION_DAYS as fallback
# If an image belongs to multiple groups in mode 2, the longest value wins.
AUTO_RETENTION=0
IMAGE_RETENTION_DAYS=30

# Sources config — one entry per ingestion account/source (each with its own
# cookies so the watcher launches a separate headless browser per account).
# Defaults to ./sources.json. See sources.example.json.
SOURCES_FILE=./sources.json

# State file — tracks seen posts to avoid duplicates
STATE_FILE=./state.json

# Custom hook script — receives post data as JSON on stdin.
# When commented out (default) the platform default is used:
#   Linux/macOS → ./hooks/on-new-post.sh   Windows → ./hooks/on-new-post.js
# Set this explicitly to use a custom hook file.
# HOOK_SCRIPT=./hooks/on-new-post.sh

# Screenshots directory
SCREENSHOTS_DIR=./screenshots

# Logs directory
LOGS_DIR=./logs

# User agent — use a realistic one to avoid detection
USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/147.0.0.0 Safari/537.36"

# Page timeout (ms) — Instagram can be slow
PAGE_TIMEOUT=30000

# Scroll count — how many times to scroll the feed to load posts
SCROLL_COUNT=3

# Debug mode — saves screenshots and verbose logs
DEBUG=true
